# Supabase → Project Settings → API. Add both in Vercel → Settings → Environment Variables.
# The anon/publishable key is safe in the browser (access rules protect the data).
# NEVER put the service_role / secret key here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
